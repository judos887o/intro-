tween(logoShadowCorner, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CornerRadius = CFG.Look.CornerLoading })

local loadLogoSize = math.floor(150 * scale)
tween(logo, TweenInfo.new(0.40, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
	Size = UDim2.fromOffset(loadLogoSize, loadLogoSize),
	Position = UDim2.new(0.5, 0, 0.45, 0)
})
tween(logoShadow, TweenInfo.new(0.40, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
	Size = UDim2.fromOffset(loadLogoSize, loadLogoSize),
	Position = UDim2.new(0.5, 0, 0.45, math.floor(6 * scale))
})

tween(logoStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.35 })

tween(loadingText, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 })
tween(fill, TweenInfo.new(CFG.Times.Load, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 1, 0) })

loadingSound = create("Sound", {
	SoundId = CFG.Assets.LoadSfx,
	Volume = 1.5,
	Parent = SoundService
})
loadingSound:Play()

task.wait(CFG.Times.ToLoad)

phase = "Loading"
loadingStart = os.clock()

task.wait(CFG.Times.Load)

if conn then conn:Disconnect() conn = nil end
logo.Rotation = 0

getgenv().SchmecktIntroFinished = true

local out = TweenInfo.new(CFG.Times.FadeOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

tween(logo, out, { ImageTransparency = 1, Size = UDim2.fromOffset(0, 0) })
tween(logoShadow, out, { ImageTransparency = 1, Size = UDim2.fromOffset(0, 0) })
tween(logoStroke, out, { Transparency = 1 })
tween(loadingText, out, { TextTransparency = 1 })
tween(overlay, out, { BackgroundTransparency = 1 })
for _, v in ipairs(vignetteParts) do
	tween(v, out, { BackgroundTransparency = 1 })
end
tween(blur, TweenInfo.new(CFG.Times.BlurOut, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = 0 })

if loadingSound then
	tween(loadingSound, TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Volume = 0 })
end

task.wait(CFG.Times.FadeOut + 0.10)

pcall(function() if loadingSound then loadingSound:Destroy() end end)
pcall(function() introSound:Destroy() end)
pcall(function() blur:Destroy() end)
pcall(function() gui:Destroy() end)
