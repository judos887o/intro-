local fadeInfo = TweenInfo.new(CFG.Times.FadeIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local growInfo = TweenInfo.new(CFG.Times.Grow, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

