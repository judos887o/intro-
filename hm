local sparks = {}
local function spawnSpark(s)
	s.t0 = os.clock() + rnd:NextNumber(0, 0.25)
	s.life = rnd:NextNumber(0.45, 0.8)
	s.dx0 = rnd:NextNumber(-CFG.Sparks.SpreadX, CFG.Sparks.SpreadX) * scale
	s.dy0 = rnd:NextNumber(-CFG.Sparks.SpreadY, CFG.Sparks.SpreadY) * scale
	s.rise = rnd:NextNumber(CFG.Sparks.RisePx * 0.9, CFG.Sparks.RisePx * 1.1) * scale
	s.size0 = rnd:NextNumber(CFG.Sparks.SizeMin, CFG.Sparks.SizeMax) * scale
	s.size1 = s.size0 * rnd:NextNumber(0.25, 0.45)
	s.rot0 = rnd:NextNumber(-15, 15)
	s.rotSpd = rnd:NextNumber(-50, 50)
	s.xDrift = rnd:NextNumber(-20, 20) * scale

	local cA = Color3.fromRGB(255, 160, 50)
	local cB = Color3.fromRGB(255, 30, 30)
	s.inst.ImageColor3 = cA:Lerp(cB, rnd:NextNumber(0.15, 0.75))
	s.inst.ImageTransparency = 1
	s.inst.Rotation = s.rot0
	s.inst.Size = UDim2.fromOffset(s.size0, s.size0)
	s.inst.Position = UDim2.new(firePos.X.Scale, firePos.X.Offset + s.dx0, firePos.Y.Scale, firePos.Y.Offset + s.dy0)
end

