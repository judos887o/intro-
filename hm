local vignetteParts = {}
local function vignetteEdge(name, pos, size, rotation)
	local f = create("Frame", {
		Name = name,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = pos,
		Size = size,
		ZIndex = 51,
		Parent = overlay,
	})
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.0, 0.00),
		NumberSequenceKeypoint.new(1.0, 1.00),
	})
	g.Parent = f
	table.insert(vignetteParts, f)
	return f
end

