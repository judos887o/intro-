		ScaleType = Enum.ScaleType.Fit,
		Parent = overlay,
	})
	create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = img })
	local s = { inst = img }
	spawnSpark(s)
	sparks[i] = s
end

