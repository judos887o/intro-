-- Render loop: nur Feuer + Sparks animieren (Text bleibt komplett still)
local tStart = os.clock()
local baseRot1, baseRot2 = fire1.Rotation, fire2.Rotation

local conn
conn = RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local t = now - tStart

	local nn1 = math.noise(t * 2.2, 0, 0)
	local nn2 = math.noise(0, t * 1.9, 0)

	fire1.Rotation = baseRot1 + (math.sin(t * 6.5) * 0.6) + nn2 * 0.8
	fire2.Rotation = baseRot2 - (math.sin(t * 6.0) * 0.6) + nn1 * 0.9

	local flick = 0.5 + 0.5 * math.sin(t * 16.0 + nn1 * 2.0)
	fire1.ImageTransparency = clamp(0.30 + 0.08 * flick, 0.26, 0.48)
	fire2.ImageTransparency = clamp(0.36 + 0.10 * flick, 0.30, 0.58)

	for _, s in ipairs(sparks) do
		local age = now - s.t0
		if age < 0 then
			s.inst.ImageTransparency = 1
		else
			local p = age / s.life
			if p >= 1 then
				spawnSpark(s)
			else
				local ease = p ^ 0.55
				local riseY = ease * s.rise
				local x = s.dx0 + (s.xDrift * p)

				s.inst.Position = UDim2.new(
					firePos.X.Scale, firePos.X.Offset + x,
					firePos.Y.Scale, firePos.Y.Offset + s.dy0 - riseY
				)

				local pulse = math.sin(p * math.pi)
				local sizePx = s.size1 + (s.size0 - s.size1) * pulse
				s.inst.Size = UDim2.fromOffset(sizePx, sizePx)

				s.inst.Rotation = s.rot0 + s.rotSpd * p

				local aIn = clamp(p / 0.10, 0, 1)
				local aOut = clamp((p - 0.25) / 0.75, 0, 1)
				local a = (1 - aOut) * aIn
				s.inst.ImageTransparency = clamp(1 - (0.50 * a), 0.30, 1)
			end
		end
	end
end)

task.wait(CFG.Times.Grow)

-- Logo bobbt kurz (Text bleibt still)
do
	local baseLogoPos = logo.Position
	local baseShadowPos = logoShadow.Position

	local start = os.clock()
	local duration = CFG.Times.BobDuration
	local amplitudePx = 7 * scale
	local speedHz = 2.8

	while true do
		local t = os.clock() - start
		if t >= duration then break end

		local y = math.sin(t * math.pi * 2 * speedHz) * amplitudePx
		logo.Position = UDim2.new(baseLogoPos.X.Scale, baseLogoPos.X.Offset, baseLogoPos.Y.Scale, baseLogoPos.Y.Offset + y)
		logoShadow.Position = UDim2.new(baseShadowPos.X.Scale, baseShadowPos.X.Offset, baseShadowPos.Y.Scale, baseShadowPos.Y.Offset + y)

		RunService.RenderStepped:Wait()
	end

	logo.Position = baseLogoPos
	logoShadow.Position = baseShadowPos
end

