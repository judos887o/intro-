local phase = "Intro"
local t0 = os.clock()

local baseTitlePos = introTitle.Position
local baseSubPos = introSub.Position
local baseTitleSize = introTitle.TextSize
local baseSubSize = introSub.TextSize
local baseRot1 = fire1.Rotation
local baseRot2 = fire2.Rotation

local loadingStart = 0
local loadingSound

local conn
conn = RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local t = now - t0

	if phase == "Intro" then
		local n1 = (math.noise(t * 1.6, 0, 0) * 2 - 1)
		local n2 = (math.noise(0, t * 1.9, 0) * 2 - 1)
		local n3 = (math.noise(t * 2.2, t * 1.1, 0) * 2 - 1)

		local tx = math.sin(t * 12.0) * CFG.Wobble.TitleX + n1 * 1.6
		local ty = math.cos(t * 9.5) * CFG.Wobble.TitleY + n2 * 1.2
		introTitle.Position = UDim2.new(baseTitlePos.X.Scale, baseTitlePos.X.Offset + tx, baseTitlePos.Y.Scale, baseTitlePos.Y.Offset + ty)
		titleShadow.Position = UDim2.new(introTitle.Position.X.Scale, introTitle.Position.X.Offset + math.floor(2 * scale), introTitle.Position.Y.Scale, introTitle.Position.Y.Offset + math.floor(2 * scale))
		introTitle.Rotation = math.sin(t * 11.0) * CFG.Wobble.TitleRot + n3 * 0.5
		introTitle.TextSize = baseTitleSize * (1 + math.sin(t * 7.0) * 0.030)

		local sx = math.sin(t * 13.5 + 0.7) * CFG.Wobble.SubX + n2 * 1.8
		local sy = math.cos(t * 10.5 + 0.3) * CFG.Wobble.SubY + n1 * 1.4
		introSub.Position = UDim2.new(baseSubPos.X.Scale, baseSubPos.X.Offset + sx, baseSubPos.Y.Scale, baseSubPos.Y.Offset + sy)
		subShadow.Position = UDim2.new(introSub.Position.X.Scale, introSub.Position.X.Offset + math.floor(2 * scale), introSub.Position.Y.Scale, introSub.Position.Y.Offset + math.floor(2 * scale))
		introSub.Rotation = math.sin(t * 12.5 + 0.4) * CFG.Wobble.SubRot + n3 * 0.7
		introSub.TextSize = baseSubSize * (1 + math.sin(t * 8.2 + 0.8) * 0.040)

		local nn1 = math.noise(t * 2.2, 0, 0)
		local nn2 = math.noise(0, t * 1.9, 0)

		fire1.Rotation = baseRot1 + (math.sin(t * 6.5) * 0.6) + nn2 * 0.8
		fire2.Rotation = baseRot2 - (math.sin(t * 6.0) * 0.6) + nn1 * 0.9

		local flick = 0.5 + 0.5 * math.sin(t * 16.0 + nn1 * 2.0)
		fire1.ImageTransparency = clamp(0.30 + 0.08 * flick, 0.26, 0.48)
		fire2.ImageTransparency = clamp(0.36 + 0.10 * flick, 0.30, 0.58)

		for _, s in ipairs(sparks) do
			local age = now - s.t0
			if age < 0 then
				s.inst.ImageTransparency = 1
			else
				local p = age / s.life
				if p >= 1 then
					spawnSpark(s)
				else
					local ease = p ^ 0.55
					local riseY = ease * s.rise
					local x = s.dx0 + (s.xDrift * p)

					s.inst.Position = UDim2.new(
						firePos.X.Scale, firePos.X.Offset + x,
						firePos.Y.Scale, firePos.Y.Offset + s.dy0 - riseY
					)

					local pulse = math.sin(p * math.pi)
					local sizePx = s.size1 + (s.size0 - s.size1) * pulse
					s.inst.Size = UDim2.fromOffset(sizePx, sizePx)

					s.inst.Rotation = s.rot0 + s.rotSpd * p

					local aIn = clamp(p / 0.10, 0, 1)
					local aOut = clamp((p - 0.25) / 0.75, 0, 1)
					local a = (1 - aOut) * aIn
					s.inst.ImageTransparency = clamp(1 - (0.50 * a), 0.30, 1)
				end
			end
		end
	end

	if phase == "Loading" then
		local lt = now - loadingStart
		local dots = string.rep(".", (math.floor(lt * 2) % 4))
		loadingText.Text = "Loading" .. dots
		fillGrad.Rotation = (lt * 140) % 360

		local pulse = 1 + math.sin(lt * 3) * 0.03
		local base = math.floor(150 * scale)
		logo.Size = UDim2.fromOffset(base * pulse, base * pulse)
		logoShadow.Size = logo.Size
		logo.Rotation = math.sin(lt * 2) * 1.8
		logoStroke.Transparency = 0.30 + math.sin(lt * 4) * 0.12
	end
end)

