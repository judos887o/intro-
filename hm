local function makeText(name, pos, sizePx, text, font, baseColor, z)
	local shadow = create("TextLabel", {
		Name = name .. "_Shadow",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(pos.X.Scale, pos.X.Offset + math.floor(3 * scale), pos.Y.Scale, pos.Y.Offset + math.floor(3 * scale)),
		Size = UDim2.new(0, math.floor(900 * scale), 0, math.floor(80 * scale)),
		Font = font,
		Text = text,
		TextColor3 = Color3.fromRGB(0, 0, 0),
		TextSize = math.floor(sizePx * scale),
		TextTransparency = 1,
		ZIndex = z,
		Parent = overlay,
	})

	local lbl = create("TextLabel", {
		Name = name,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = shadow.Size,
		Font = font,
		Text = text,
		TextColor3 = baseColor,
		TextSize = shadow.TextSize,
		TextTransparency = 1,
		ZIndex = z + 1,
		Parent = overlay,
	})

	return lbl, shadow
end

